{
  "$schema": "https://turborepo.com/schema.json",
  "futureFlags": {
    "githubActionsRemoteBaseRefFallback": true
  },
  "ui": "tui",
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**", ".cloudflare/output/**"]
    },
    "web#build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".cloudflare/output/**",
        "!.cloudflare/output/**/.dev.vars",
        ".cloudflare/types/**"
      ],
      "env": ["MAPBOX_SERVER_TOKEN", "RESEND_API_KEY", "VITE_POSTHOG_KEY"]
    },
    "studio#build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**", "!.svelte-kit/cache/**", "build/**", ".cloudflare/output/**"],
      "env": ["PUBLIC_POSTHOG_KEY"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
