# Builtime
VITE_API_URL="http://localhost:8787" # The base endpoint for the backend API
VITE_MAPBOX_TOKEN="" # Public Mapbox access token required to initialize map components and load map tiles
VITE_SITE_URL="https://www.railradar24.com" # Public site URL used for Open Graph meta tags and canonical URLs
VITE_POSTHOG_KEY="" # PostHog project API key (EU cloud); events are proxied through t.railradar24.com

# Runtime
MAPBOX_SERVER_TOKEN="" # Server-side Mapbox token used to render Open Graph map images
