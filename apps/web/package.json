{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "deploy": "wrangler deploy --minify",
    "deploy:preview": "if [ \"${WORKERS_CI_BRANCH:-$(git branch --show-current)}\" = preview ]; then vite build && wrangler preview --name preview; else vite build && wrangler deploy --dry-run; fi",
    "versions": "wrangler versions upload",
    "cf-typegen": "wrangler types",
    "lint": "oxlint --deny warnings",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/data": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "lucide-react": "^1.48.0",
    "mapbox-gl": "^3.31.0",
    "motion": "^12.43.0",
    "posthog-js": "^1.434.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "takumi-js": "^2.14.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
  }
}
