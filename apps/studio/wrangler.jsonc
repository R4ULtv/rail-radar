{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rail-radar-studio",
  "compatibility_date": "2026-09-08",
  "limits": {
    "cpu_ms": 100,
  },
  "assets": {
    "directory": "build",
  },
  "routes": [
    {
      "pattern": "studio.railradar24.com",
      "custom_domain": true,
    },
  ],
}
