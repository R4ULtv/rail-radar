{
  "extends": "$app/tsconfig",
  "include": ["src", "tests", "vite-plugins", "vite.config.ts"],
  "exclude": ["src/service-worker", "node_modules", "build"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "types": ["$app/types", "node", "svelte"]
  }
}
