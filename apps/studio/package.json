{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "cf dev",
    "dev:worker": "cf dev",
    "build": "cf build",
    "preview": "vite preview --port 3001",
    "deploy": "cf deploy",
    "versions": "cf workers versions create",
    "cf-typegen": "cf workers types --no-include-runtime",
    "sync": "svelte-kit sync",
    "lint": "oxlint --deny warnings src",
    "check-types": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@sveltejs/kit": "^3.1.1",
    "maplibre-gl": "^6.17.0",
    "posthog-js": "^1.447.7",
    "svelte": "^5.57.3",
    "vite": "^8.3.7"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.10",
    "@cloudflare/config": "0.30.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.71.0",
    "@repo/data": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "bits-ui": "^2.20.6",
    "cf": "1.0.0-beta.28",
    "cn": "^0.2.6",
    "shadcn-svelte": "^1.8.0",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
