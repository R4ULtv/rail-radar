{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["./.cloudflare/types/index.d.ts"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", ".cloudflare/types/index.d.ts", "cloudflare.config.ts", "wrangler.config.ts"],
  "exclude": ["node_modules", "dist"]
}
