+// Runs one Vite preview server for parallel prerendering (prerender.workers).
+// Each worker is a separate process, so plugins that keep module-level state
+// (such as a single runtime instance) get their own copy per worker.
+import { preview } from "vite";
+const { configFile } = JSON.parse(process.env.TSS_PRERENDER_PREVIEW_OPTIONS ?? "{}");
+let server;
+try {
+	server = await preview({
+		configFile,
+		preview: {
+			port: 0,
+			open: false
+		}
+	});
+	const url = server.resolvedUrls?.local[0];
+	if (!url) throw new Error("No resolved URL is available from the Vite preview server");
+	process.send({
+		type: "ready",
+		url
+	});
+} catch (error) {
+	process.send({
+		type: "error",
+		message: error instanceof Error ? error.message : String(error),
+		stack: error instanceof Error ? error.stack : void 0
+	});
+	process.exit(1);
+}
+async function shutdown() {
+	try {
+		await server.close();
+	} finally {
+		process.exit(0);
+	}
+}
+process.on("message", (message) => {
+	if (message?.type === "close") shutdown();
+});
+// The build process exited or crashed: don't leave this server running.
+process.on("disconnect", shutdown);
